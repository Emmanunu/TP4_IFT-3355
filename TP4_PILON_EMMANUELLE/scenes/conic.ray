Dimensions 640 480
Perspective 30.0 1.33 1.0 20

# Caméra
LookAt  1.2434  1.2533  9.8429
       -0.1243 -0.1253 -0.9843
       -0.0157  0.9921 -0.1243

# Matériau Bleu "Mat" (mieux pour voir les ombres)
# Ambiante faible et grise (pas bleue) pour le contraste
# Shininess réduite à 50 (au lieu de 500) pour voir le reflet
Material "blue_matte"
    "ambient"   [0.1 0.1 0.1]
    "diffuse"   [0.1 0.1 0.8]
    "specular"  [1.0 1.0 1.0]
    "emission"  [0.0 0.0 0.0]
    "shininess" 50.0
    "reflect"   0.1

Material "white_floor"
    "ambient"   [0.1 0.1 0.1]
    "diffuse"   [0.8 0.8 0.8]
    "specular"  [0 0 0]
    "reflect"   0.0

# --- LE CÔNE ---
PushMatrix
    Translate 0.0 -1.25 0.0
    Rotate -90 1 0 0
    # Utilisation du nouveau matériau
    Conic 1.0 0.0 0.0 2.0 "blue_matte"
PopMatrix

# Le Sol
PushMatrix
    Translate 0 -1.25 0
    Rotate -90 1 0 0
    Scale 10 10 1
    Plane "white_floor"
PopMatrix

# Lumière principale (Déplacée légèrement sur le côté pour le relief)
PointLight 4.0 4.0 10.0
    "ambient"  [0.1 0.1 0.1]
    "diffuse"  [1.0 1.0 1.0]
    "specular" [1.0 1.0 1.0]
    "attenuation" [1.0 0.0 0.0]